# ── Serial / Arduino ─────────────────────────────
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# ── Database ─────────────────────────────────────
DATABASE_URL=sqlite:///data/thevault.db

# ── Vault Storage ────────────────────────────────
VAULT_DIR=data/vaults

# ── Flask ────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret
FLASK_DEBUG=1
